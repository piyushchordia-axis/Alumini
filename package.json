{
  "name": "illuminize",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @illuminize/api db:migrate",
    "db:seed": "pnpm --filter @illuminize/api db:seed",
    "db:reset": "pnpm --filter @illuminize/api db:reset",
    "api": "pnpm --filter @illuminize/api dev",
    "worker": "pnpm --filter @illuminize/api worker",
    "web": "pnpm --filter @illuminize/web dev",
    "mobile": "pnpm --filter @illuminize/mobile start",
    "mobile:tunnel": "pnpm --filter @illuminize/mobile tunnel",
    "mobile:web": "pnpm --filter @illuminize/mobile web:preview",
    "demo": "bash scripts/demo.sh",
    "e2e:web": "node e2e/web-member.mjs",
    "e2e:admin": "node e2e/web-admin.mjs",
    "e2e:mobile-web": "node e2e/mobile-web.mjs",
    "jobs:run": "pnpm --filter @illuminize/api jobs:run"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "playwright": "^1.64.1"
  }
}
