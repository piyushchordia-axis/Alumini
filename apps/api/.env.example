NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres + Redis
DATABASE_URL=postgres://postgres:postgres@localhost:5432/illuminize
REDIS_URL=redis://localhost:6379/0

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-otp-pepper-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# OTP delivery: console | whatsapp | sms
OTP_PROVIDER=console
# Fixed OTP code for local development (ignored in production)
OTP_DEV_FIXED_CODE=123456
# Hard cap on OTP sends per day across the platform (cost control)
OTP_GLOBAL_DAILY_CAP=5000

# Meta WhatsApp Cloud API (OTP_PROVIDER=whatsapp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=illuminize_otp
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0

# SMS fallback (MSG91) – used when WhatsApp delivery fails or OTP_PROVIDER=sms
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Comma-separated E.164 phone numbers that become platform admins on login
PLATFORM_ADMIN_PHONES=+919999999999

# Public URL used to build upload links and CORS
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
UPLOAD_DIR=./uploads
# Image uploads allowed per institution per day (all members together).
UPLOADS_PER_TENANT_DAILY_CAP=2000
# Billing periods and member activity days use this time zone.
BILLING_TIMEZONE=Asia/Kolkata

# Expo push (optional)
EXPO_ACCESS_TOKEN=
