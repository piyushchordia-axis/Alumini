NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres + Redis
DATABASE_URL=postgres://postgres:postgres@localhost:5432/illuminize
REDIS_URL=redis://localhost:6379/0

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-otp-pepper-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# OTP delivery: console | whatsapp | sms
OTP_PROVIDER=console
# Fixed OTP code for local development (ignored in production)
OTP_DEV_FIXED_CODE=123456
# Hard cap on OTP sends per day across the platform (cost control)
OTP_GLOBAL_DAILY_CAP=5000

# Meta WhatsApp Cloud API (OTP_PROVIDER=whatsapp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=illuminize_otp
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0

# SMS fallback (MSG91) – used when WhatsApp delivery fails or OTP_PROVIDER=sms
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Comma-separated E.164 phone numbers that become platform admins on login
PLATFORM_ADMIN_PHONES=+919999999999

# Public URL used to build upload links and CORS
PUBLIC_BASE_URL=http://localhost:4000
# Where members open the web app; links in emails and messages (email confirmation, invites, digest) point here.
# Defaults to http://localhost:5173 outside production; in production those features stay off until it is set.
WEB_APP_URL=http://localhost:5173
# EMAIL_VERIFY_GLOBAL_DAILY_CAP=5000   # confirmation emails per day across the platform
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
UPLOAD_DIR=./uploads
# Image uploads allowed per institution per day (all members together).
UPLOADS_PER_TENANT_DAILY_CAP=2000
# Billing periods and member activity days use this time zone.
BILLING_TIMEZONE=Asia/Kolkata

# Expo push (optional)
EXPO_ACCESS_TOKEN=

# --- Background jobs (BullMQ on REDIS_URL) ---
# inline: workers run inside the API process (default outside production, used by `pnpm demo`).
# separate: run `pnpm worker` (or `node dist/worker.js`) as its own process (default in production).
WORKER_MODE=
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=4001

# --- Outbound messages (WhatsApp / SMS / email; OTPs use the OTP_* settings above) ---
# WhatsApp reuses WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID; each message type uses an approved template.
# SMS uses MSG91_AUTH_KEY with one DLT flow template per message type:
MSG91_FLOW_TEMPLATE_IDS=
# Email over SMTP (any provider: Amazon SES, Zoho, Google Workspace, Resend, SendGrid). Set SPF/DKIM for the domain.
# SMTP_URL=smtps://USER:PASSWORD@smtp.zoho.in:465
SMTP_URL=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Unconfigured channels log to the console outside production. Check a setup with POST /api/v1/platform/messages/test.

# --- Image storage ---
# local (default): files in UPLOAD_DIR, served at /uploads. s3: any S3-compatible bucket (AWS S3, Cloudflare R2,
# DigitalOcean Spaces, MinIO). The bucket (or a CDN in front of it) must be publicly readable.
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=us-east-1            # "auto" for Cloudflare R2
# S3_ENDPOINT=                   # only for R2 / Spaces / MinIO
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=              # both or neither (neither = default AWS credentials, e.g. an instance role)
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=            # e.g. https://cdn.example.com or https://<bucket>.s3.amazonaws.com
# Local MinIO (docker compose --profile s3 up -d):
# STORAGE_PROVIDER=s3
# S3_BUCKET=illuminize
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_BASE_URL=http://localhost:9000/illuminize

# --- Online payments (event tickets and donations use these from Wave 3) ---
# mock (default outside production): a fake checkout for development. razorpay: real payments. disabled: off.
PAYMENTS_PROVIDER=
# Razorpay dashboard → Account & Settings → API keys (rzp_test_… for test mode). Enable auto-capture.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: ${PUBLIC_BASE_URL}/api/v1/webhooks/razorpay with payment.authorized, payment.captured, payment.failed,
# order.paid, refund.processed and refund.failed; the secret you set there goes here.
RAZORPAY_WEBHOOK_SECRET=

