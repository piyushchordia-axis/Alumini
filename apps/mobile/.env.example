# API base URL reachable from the device/emulator.
# Android emulator: http://10.0.2.2:4000 ; iOS simulator: http://localhost:4000 ; physical device: http://<your-lan-ip>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Expo project id (expo.dev → your project, or run `eas init`). Needed for push notifications in development and
# store builds; Expo Go cannot receive push. Read by app.config.ts at build time.
EAS_PROJECT_ID=
