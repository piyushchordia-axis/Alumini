# Keep LF line endings in the working tree on every OS. Git for Windows defaults to core.autocrlf=true, which would
# check out CRLF and break the shell scripts in containers (`set -o pipefail\r`) and mixed-platform diffs.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
